# Public canonical URL used for metadata, JSON-LD and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin accounts (SERVER-ONLY secrets — never commit real values, never
# prefix with NEXT_PUBLIC_). Generate a unique strong password per account:
#   openssl rand -base64 24
RAKEB_ADMIN_EMAIL=
RAKEB_ADMIN_PASSWORD=
RAKEB_EDITOR_EMAIL=
RAKEB_EDITOR_PASSWORD=

# 32+ random characters. Used to sign the admin session cookie.
#   openssl rand -hex 32
RAKEB_AUTH_SECRET=

# Salt for anonymised rider-report hashes (rotate regularly, server-only).
RAKEB_REPORT_SALT=

# Optional: where JSON state is persisted during local development.
# RAKEB_STATE_FILE=.data/state.json

# Optional: fabricate demo delays/cancellations/reports for LOCAL review only.
# Never enable in production. Default: off.
# RAKEB_ENABLE_DEMO_SEED=0
