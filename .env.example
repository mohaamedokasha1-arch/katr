# Public canonical URL used for metadata, JSON-LD and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo admin credentials (replace with Auth.js / SSO in production).
RAKEB_ADMIN_EMAIL=admin@rakeb.app
RAKEB_ADMIN_PASSWORD=Rakeb#2026
RAKEB_EDITOR_EMAIL=editor@rakeb.app
RAKEB_EDITOR_PASSWORD=Rakeb#2026

# 32+ random characters. Used to sign the admin session cookie.
RAKEB_AUTH_SECRET=dev-only-change-me-please-32-chars-min

# Optional: where JSON state is persisted during local development.
# RAKEB_STATE_FILE=.data/state.json

# Optional: seed date overrides relative to today (1) or use neutral dates (0).
# RAKEB_SEED_STATE=1
